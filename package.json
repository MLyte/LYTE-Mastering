{
  "name": "lyte-mastering",
  "version": "0.3.0-beta.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev --no-dev-server",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "tauri": "tauri",
    "desktop:build": "npm run check:bundle && tauri build && node scripts/stage-runtime.mjs",
    "check:runtime": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-runtime.ps1",
    "test:ui": "npm run build && playwright test",
    "check:bundle": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-runtime.ps1 -RequireBundled",
    "test:native": "node scripts/test-native.mjs",
    "test:native:comparison": "node scripts/test-comparison-native.mjs",
    "prebuild": "node scripts/stamp-build-time.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.8.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.0",
    "vue-tsc": "^3.0.0"
  }
}
