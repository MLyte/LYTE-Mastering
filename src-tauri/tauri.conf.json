{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LYTE Mastering",
  "version": "0.1.0",
  "identifier": "be.lyte.mastering",
  "build": {
    "beforeDevCommand": {
      "script": "npm run build",
      "wait": true
    },
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LYTE Mastering",
        "width": 600,
        "height": 850,
        "minWidth": 380,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": {
      "../bin/": "bin/",
      "../resources/phaselimiter/": "resources/phaselimiter/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
