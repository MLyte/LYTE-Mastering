{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LYTE Mastering",
  "version": "2026.9.20",
  "identifier": "be.lyte.mastering",
  "build": {
    "beforeDevCommand": {
      "script": "npm run build",
      "wait": true
    },
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LYTE Mastering v2026.9.20 · build 02:55",
        "width": 720,
        "height": 640,
        "minWidth": 460,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' asset:; connect-src ipc: http://ipc.localhost",
      "assetProtocol": { "enable": true, "scope": ["$TEMP/lyte-mastering/**/*"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": {
      "../bin/": "bin/",
      "../resources/phaselimiter/": "resources/phaselimiter/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
